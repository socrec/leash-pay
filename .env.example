# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app's Webhooks section
PAYPAL_WEBHOOK_ID=
# Optional: defaults to the sandbox
# PAYPAL_BASE=https://api-m.sandbox.paypal.com

# Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5
# LLM_MODEL=claude-opus-5-5

# Required anywhere but localhost (Render, a tunnel to the UI, your LAN): the browser asks for it, any username.
# Unset, the app only answers requests addressed to localhost (the PayPal webhook is exempt).
# APP_PASSWORD=

# Optional: re-attach an already saved sandbox PayPal account after the database resets
# (Render's free tier wipes SQLite on every deploy/restart)
# DEMO_VAULT_ID=
# DATABASE_URL=sqlite:///leashpay.db

# Optional: AG Studio licence key (free 45-day trial at ag-grid.com/studio/license-pricing). Without it the audit-log
# dashboard still works, with a watermark. AG licence keys are meant to ship in the browser bundle, so it isn't a secret.
# VITE_AG_LICENSE_KEY=
